{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/app/features/quant/**/*.ts",
    "src/app/features/quant/**/*.tsx",
    "src/app/lib/api.ts"
  ],
  "exclude": [
    "src/app/features/quant/**/*.test.ts",
    "src/app/features/quant/**/*.test.tsx"
  ]
}
